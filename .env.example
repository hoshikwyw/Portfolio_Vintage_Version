# Supabase — project URL and public anon key (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenWeather — API key for the taskbar weather widget (openweathermap.org)
VITE_OPENWEATHER_API_KEY=

# --- Server-only (set in Vercel, NOT prefixed with VITE_) ---
# Optional shared secret to lock down the /api/keep-alive endpoint. When set,
# the cron caller must send it via `Authorization: Bearer <secret>` or ?secret=.
# CRON_SECRET=

